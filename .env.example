# Copie para .env e preencha. Nunca versione o arquivo .env.
DB_NAME=provafinal
DB_USER=prova
DB_PASSWORD=troque-esta-senha
AUTH0_ISSUER=https://SEU_TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://provafinal-api
FRONTEND_ORIGINS=http://localhost:5173
APP_PORT=8080
# Para deploy sem build local:
IMAGE=seu-usuario/prova-final-api:tag-do-commit

# O endpoint pode ser trocado sem alterar o controller.
API_RESOURCE_PATH=/registros
API_READ_ROLES=ADMIN,USER
API_WRITE_ROLES=ADMIN
